{
  "name": "rk3588-sensevoice",
  "description": "Rockchip RK3588: SenseVoice offline ASR on the NPU (RKNN fp16, zh/en/ja/ko/yue). ASR-only transcription profile (no TTS) — SenseVoice encoder+CTC serves the offline /asr path. Uses the rk3588-specific .rknn.",
  "asr_backend": "rk.asr",
  "asr_model_id": "sensevoice",
  "execution_policy": {
    "mode": "concurrent",
    "shared_resource": "npu"
  },
  "env": {
    "LANGUAGE_MODE": "rk",
    "RK_PLATFORM": "rk3588",
    "ASR_BACKEND": "sensevoice_rknn",
    "ASR_PLATFORM": "rk3588",
    "SENSEVOICE_RKNN_MODEL_DIR": "/opt/asr/sensevoice-rknn",
    "ASR_MODEL_DIR": "/opt/asr/models",
    "RK_ARTIFACT_AUTO_DOWNLOAD": "0",
    "RK_ENSURE_MATCHA_RESOURCES": "0",
    "SENSEVOICE_RKNN_WORKERS": "3",
    "ASR_MAX_SESSIONS": "8",
    "OVS_ASR_INFER_CONCURRENCY": "3"
  }
}
