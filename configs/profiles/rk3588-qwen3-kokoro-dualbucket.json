{
  "name": "rk3588-qwen3-kokoro-dualbucket",
  "description": "Rockchip RK3588: Qwen3 ASR (RKNN encoder + RKLLM decoder W8A8) + Kokoro Dual-Bucket NPU TTS",
  "asr_backend": "rk.asr",
  "asr_model_id": "qwen3-asr",
  "tts_backend": "rk.tts",
  "tts_model_id": "kokoro-convonly-v1_0-rk3588",
  "execution_policy": {
    "mode": "serialized",
    "shared_resource": "npu"
  },
  "env": {
    "LANGUAGE_MODE": "rk",
    "RK_PLATFORM": "rk3588",
    "RK_ARTIFACT_SET": "rk3588-multilang-2026-05-17",
    "ASR_BACKEND": "qwen3_asr_rk",
    "OVS_VAD_BACKEND": "silero",
    "OVS_VAD_SILENCE_MS": "400",
    "ASR_DECODER_TYPE": "rkllm",
    "ASR_PLATFORM": "rk3588",
    "ASR_DECODER_QUANT": "w8a8",
    "ASR_DECODER_EMBED_CACHE_REUSE": "1",
    "ASR_DECODER_ASYNC": "1",
    "ASR_MAX_NEW_TOKENS": "64",
    "ASR_FINAL_STOP_ON_PUNCT": "0",
    "ASR_FINAL_STOP_MIN_CHARS": "8",
    "ASR_FINAL_STOP_MIN_CHUNKS": "2",
    "ASR_NPU_CORE_MASK": "NPU_CORE_1",
    "ASR_ENABLED_CPUS": "4",
    "ASR_MODEL_DIR": "/opt/asr/models",
    "RKLLM_LIB_PATH": "/opt/asr/lib/librkllmrt.so",
    "QWEN3_ASR_CHUNK_CONFIRM": "0",
    "QWEN3_ASR_STREAM_MODE": "true_streaming",
    "QWEN3_ASR_STREAM_TRUE": "1",
    "QWEN3_ASR_TRUE_ROLL_SEC": "5",
    "QWEN3_ASR_TRUE_PARTIAL_TOKENS": "8",
    "QWEN3_ASR_TRUE_PARTIAL_INTERVAL_MS": "1500",
    "QWEN3_ASR_TRUE_PARTIAL_WARMUP": "2",
    "QWEN3_ASR_VAD_FINAL_ASYNC": "1",
    "QWEN3_ASR_FRONTEND_EOU_MIN_AUDIO_S": "2.5",
    "VAD_ENDPOINT_SILENCE_MS": "1500",
    "TTS_BACKEND": "kokoro_dualbucket",
    "KOKORO_DUALBUCKET_ROOT": "/opt/kokoro-dualbucket/rk3588",
    "KOKORO_CONVONLY_ROOT": "/opt/kokoro-dualbucket/rk3588",
    "KOKORO_DUALBUCKET_MANIFEST_SHA256": "cfc6aa8d485415884e4cf5eac47b0a786889ed02d9556a1051ed66685927083d",
    "KOKORO_CONVONLY_MANIFEST_SHA256": "cfc6aa8d485415884e4cf5eac47b0a786889ed02d9556a1051ed66685927083d",
    "KOKORO_DEFAULT_VOICE": "af_heart",
    "KOKORO_VOICE": "af_heart",
    "KOKORO_FRONTEND_INTRA_OP_THREADS": "4",
    "KOKORO_FRONTEND_INTER_OP_THREADS": "1",
    "RK_ARTIFACT_AUTO_DOWNLOAD": "0",
    "RK_ENSURE_MATCHA_RESOURCES": "0"
  }
}
