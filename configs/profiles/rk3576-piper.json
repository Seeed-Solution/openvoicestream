{
  "name": "rk3576-piper",
  "description": "Rockchip RK3576 bilingual profile: Qwen3 ASR with Piper VITS English and opt-in Matcha Chinese fallback. The existing artifact contract keeps PIPER_SEQ_LEN=256 for the original hybrid fallback; when the staged frontend manifest is loaded, its bucket (currently 128) supplies the runtime sequence length. Chinese uses the existing Matcha RKNN/ORT resources from the default profile. The decoder is exported at a fixed 512 mel frames = 5.94 s per decode; longer sentences are rendered in overlapping windows and stitched.",
  "asr_backend": "rk.asr",
  "asr_model_id": "qwen3-asr",
  "tts_backend": "rk.tts",
  "execution_policy": {
    "mode": "serialized",
    "shared_resource": "npu"
  },
  "env": {
    "LANGUAGE_MODE": "rk",
    "RK_PLATFORM": "rk3576",
    "RK_ARTIFACT_SET": "rk3576-piper-en-2026-09-20",
    "ASR_BACKEND": "qwen3_asr_rk",
    "OVS_VAD_BACKEND": "silero",
    "OVS_VAD_SILENCE_MS": "400",
    "ASR_DECODER_TYPE": "rkllm",
    "ASR_PLATFORM": "rk3576",
    "ASR_DECODER_QUANT": "w8a8",
    "ASR_DECODER_EMBED_CACHE_REUSE": "1",
    "ASR_DECODER_ASYNC": "1",
    "ASR_MAX_NEW_TOKENS": "64",
    "ASR_FINAL_STOP_ON_PUNCT": "0",
    "ASR_FINAL_STOP_MIN_CHARS": "8",
    "ASR_FINAL_STOP_MIN_CHUNKS": "2",
    "ASR_NPU_CORE_MASK": "NPU_CORE_1",
    "ASR_ENABLED_CPUS": "4",
    "ASR_MODEL_DIR": "/opt/asr/models",
    "RKLLM_LIB_PATH": "/opt/asr/lib/librkllmrt.so",
    "QWEN3_ASR_CHUNK_CONFIRM": "0",
    "QWEN3_ASR_STREAM_MODE": "true_streaming",
    "QWEN3_ASR_STREAM_TRUE": "1",
    "QWEN3_ASR_TRUE_ROLL_SEC": "5",
    "QWEN3_ASR_TRUE_PARTIAL_TOKENS": "8",
    "QWEN3_ASR_TRUE_PARTIAL_INTERVAL_MS": "1500",
    "QWEN3_ASR_TRUE_PARTIAL_WARMUP": "2",
    "QWEN3_ASR_VAD_FINAL_ASYNC": "0",
    "QWEN3_ASR_FRONTEND_EOU_MIN_AUDIO_S": "2.5",
    "VAD_ENDPOINT_SILENCE_MS": "1500",
    "TTS_MODEL_DIR": "/opt/tts/models",
    "TTS_BACKEND": "piper_rknn",
    "SHERPA_TTS_MODEL_DIR": "/opt/tts/models/matcha-icefall-zh-en",
    "TTS_PROVIDER": "cpu",
    "TTS_NUM_THREADS": "4",
    "TTS_DEFAULT_SID": "0",
    "MODEL_DIR": "/opt/tts/models",
    "MATCHA_USE_ORT": "1",
    "MATCHA_MODEL": "matcha-s64.rknn",
    "MATCHA_MAX_PHONEMES": "64",
    "MATCHA_MODEL_SEQ_LEN": "80",
    "MATCHA_MIN_MEL_FRAMES": "96",
    "MATCHA_STREAM_CHUNK_MS": "40",
    "VOCOS_MODEL": "vocos-16khz-600.rknn",
    "VOCOS_FRAMES": "600",
    "PIPER_MODEL_DIR": "/opt/tts/models/piper",
    "PIPER_LANGUAGES": "en_US",
    "PIPER_DEFAULT_LANG": "en_US",
    "PIPER_SEQ_LEN": "256",
    "PIPER_ENABLE_FRONTEND_NPU": "1",
    "PIPER_CHINESE_FALLBACK": "matcha_rknn",
    "RK_ARTIFACT_AUTO_DOWNLOAD": "0",
    "RK_ENSURE_MATCHA_RESOURCES": "0"
  },
  "tts_model_id": "piper-en-us-lessac-512mel"
}
