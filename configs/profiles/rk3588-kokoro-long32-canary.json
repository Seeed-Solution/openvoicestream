{
  "name": "rk3588-kokoro-long32-canary",
  "description": "RK3588 Kokoro v1.0 long32 canary. The target-specific long32 bundle is mounted separately from the rollback hybrid bundle; this profile must not be used with an RK3576 bundle.",
  "asr_backend": null,
  "tts_backend": "rk.tts",
  "execution_policy": {"mode": "serialized", "shared_resource": "npu"},
  "env": {
    "LANGUAGE_MODE": "rk",
    "RK_ENSURE_MATCHA_RESOURCES": "0",
    "RK_PLATFORM": "rk3588",
    "ASR_BACKEND": "disabled",
    "TTS_BACKEND": "kokoro_rknn",
    "KOKORO_RKNN_MODE": "long32",
    "KOKORO_MODEL_DIR": "/opt/kokoro-hybrid",
    "KOKORO_LONG32_ROOT": "/opt/kokoro-long32/rk3588",
    "KOKORO_LONG32_FRONTEND_ROOT": "/opt/kokoro-long32-frontend",
    "KOKORO_LONG32_PLATFORM": "rk3588",
    "KOKORO_RKNN_PLATFORM": "rk3588",
    "KOKORO_LONG32_ROUTE_TS": "400,640",
    "KOKORO_LONG32_MAX_SNAP_RATIO": "0.10",
    "KOKORO_LONG32_MAX_GENERATOR_RTF": "0.30",
    "KOKORO_LONG32_ENFORCE_RTF": "0",
    "KOKORO_LONG32_FALLBACK": "hybrid",
    "KOKORO_PREFIX_ONNX": "kokoro-prefix-cpu.onnx",
    "KOKORO_FRONT_RKNN": "rk3588/kokoro-decoder-front.int8.rknn",
    "KOKORO_TAIL_ONNX": "kokoro-generator-tail-cpu.onnx",
    "KOKORO_RKNN_VOCODER_FRONT_PATH": "rk3588/kokoro-vocoder-front-half.native.fp16.rknn",
    "KOKORO_RKNN_TAIL_REST_PATH": "kokoro-vocoder-tail-rest-cpu.onnx",
    "KOKORO_SEQ_LEN": "32",
    "KOKORO_SAMPLE_RATE": "24000",
    "KOKORO_VOICE": "default",
    "KOKORO_PREFIX_ORT_INTRA_OP": "1",
    "KOKORO_PREFIX_ORT_INTER_OP": "1",
    "KOKORO_TAIL_ORT_INTRA_OP": "4",
    "KOKORO_TAIL_ORT_INTER_OP": "1",
    "KOKORO_ORT_GRAPH_OPT": "all",
    "KOKORO_ORT_ENABLE_MEM_PATTERN": "0",
    "RK_ARTIFACT_AUTO_DOWNLOAD": "0"
  },
  "tts_model_id": "kokoro-multi-lang-v1_0"
}
