# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/

# Environment
.env

# Models (downloaded at runtime)
models/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Git worktrees
.worktrees/

# Runtime bundles copied from device builds or release artifacts.
deploy/jetson-workers/
deploy/rk-runtime/
# RK1828 (RKNN3) runtime: the on-device-built worker binary + librknn3_api.so.
# Staged build artifacts like deploy/rk-runtime/ — see services/rk1828-llm/BUILD.md
# for how to rebuild them. The MANIFEST is committed on purpose (deploy/rk-runtime
# does not, which means nothing records what binary that image expects): it is the
# only record of the expected sizes/hashes and of which main.cc the worker was
# built from, so a mismatched staging can be caught instead of silently shipped.
deploy/rk1828-runtime/*
!deploy/rk1828-runtime/MANIFEST.json
deploy/kokoro-artifacts/

# Generated performance artifacts
bench/perf/__pycache__/
bench/perf/results/
bench/parity/results/
bench/perf/corpus/short/*.wav
bench/perf/corpus/long/*.wav
bench/perf/corpus/multilingual/**/*.wav

# Large ASR eval datasets (download on demand)
tests/asr_real_wav_eval/dev-clean.tar.gz
tests/asr_real_wav_eval/librispeech/

# TRT engine files (binary, built per-device)
artifacts/engines/
artifacts/onnx/

# Local Claude Code session state (settings, worktrees, lock files)
.claude/
# Local wheel staging only (scripts/build_voxedge_wheel.sh output). Nothing in
# here is committed any more -- images install voxedge from PyPI, pinned.
deploy/wheels/*

