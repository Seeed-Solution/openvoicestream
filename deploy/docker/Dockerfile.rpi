# syntax=docker/dockerfile:1.6
#
# OpenVoiceStream — Raspberry Pi 4 / 5 (linux/arm64, ONNX Runtime CPU EP)
#
# Paraformer streaming ASR + Matcha TTS via sherpa-onnx (CPU only).
#
# ── Multi-target (BAKE_MODELS) ──────────────────────────────────────────────
# RPi bakes NO model artifacts in any variant: Paraformer ASR + Matcha TTS are
# fetched on first start from the sensecraft-statics CDN by
# server/core/model_downloader.py (LANGUAGE_MODE=zh_en → MODELS["zh_en"] tarballs),
# or bind-mounted via -v. So `base`, `final-thick`, and `final-slim` are
# identical here; the stage names exist only so CI can pass a uniform
# `--target final-slim` / `--target final-thick` across all platforms.
#
# Build (from repo root):
#   docker build -f deploy/docker/Dockerfile.rpi --target final-slim \
#     -t sensecraft-missionpack.seeed.cn/solution/seeed-local-voice:rpi-v1.0-onnx .
#
# Run:
#   docker run -p 8621:8000 \
#     -v ~/openvoicestream-rpi/models:/opt/models \
#     openvoicestream:rpi5

FROM debian:12-slim AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# Build-time PyPI mirror. Default = Tsinghua (CN-fast); override for non-CN:
#   docker build --build-arg PIP_INDEX=https://pypi.org/simple ...
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_INDEX_URL=${PIP_INDEX}

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        libasound2 libsndfile1 sox curl bzip2 \
    && rm -rf /var/lib/apt/lists/*

# Python deps (CPU-only stack)
RUN pip3 install --no-cache-dir --break-system-packages --index-url ${PIP_INDEX} \
        fastapi \
        "uvicorn[standard]" \
        soundfile \
        python-multipart \
        'numpy<2' \
        sherpa-onnx \
        onnxruntime \
        websockets \
        requests \
        "pysbd>=0.3.4" \
        "webrtcvad-wheels>=2.0.14" \
        prometheus_client

# ── voxedge (edge-native voice library) ───────────────────────────────
# Post-migration the CPU sherpa ASR/TTS backends live in voxedge
# (server/core/asr_backend.py maps cpu.sherpa_asr → voxedge.backends.sherpa.asr).
# Install the pure-Python wheel; sherpa-onnx (its only heavy dep) is already
# installed above and imported lazily, so no [sherpa] extra is needed.
ARG VOXEDGE_VERSION=0.0.14a0
# voxedge from PyPI, pinned. The old COPY of deploy/wheels/voxedge-*.whl
# referenced a file that was never committed (the directory holds only a
# provenance note), so this image could not be built from a clean clone.
# pypi.org is primary because mirrors lag fresh releases; PIP_INDEX stays as
# the fallback so a China build keeps working.
RUN pip3 install --no-cache-dir --break-system-packages --force-reinstall --no-deps \
        --index-url https://pypi.org/simple \
        --extra-index-url ${PIP_INDEX} \
        "voxedge==${VOXEDGE_VERSION}"

# Application code (post-refactor layout: server/core, server/utils — backends in voxedge)
COPY server/      /opt/speech/server/
COPY configs/  /opt/speech/configs/

# Model dir (populated at runtime via volume mount)
RUN mkdir -p /opt/models

ENV MODEL_DIR=/opt/models \
    OVS_PROFILE_DEFAULT=rpi5-default \
    LANGUAGE_MODE=zh_en \
    ASR_BACKEND=sherpa \
    TTS_BACKEND=sherpa \
    STREAMING_ASR_PROVIDER=cpu \
    OFFLINE_ASR_PROVIDER=cpu \
    ENSURE_OFFLINE_ASR=1 \
    TTS_PROVIDER=cpu \
    TTS_NUM_THREADS=4 \
    STREAMING_ASR_NUM_THREADS=4
# RPi must not inherit the LANGUAGE_MODE=zh_en -> jetson-zh-en fallback in
# profile_loader. Keep the image pinned to the CPU-only RPi profile unless an
# operator explicitly overrides OVS_PROFILE.

LABEL org.opencontainers.image.title="OpenVoiceStream (Raspberry Pi)" \
      org.opencontainers.image.source="https://github.com/suharvest/openvoicestream" \
      org.opencontainers.image.description="CPU speech service for Raspberry Pi 4/5"

WORKDIR /opt/speech
ENV PYTHONPATH=/opt/speech
EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000"]

# ── final-hailo: Whisper encoder on the Hailo-8 NPU ─────────────────────────
#
# reComputer R2000 series (Raspberry Pi 5 + Hailo-8). Adds the HailoRT Python
# bindings on top of `base` so `hailo.whisper` can run: the encoder is a
# prebuilt .hef on the NPU, the decoder stays an ONNX KV-cache graph on the CPU
# (onnxruntime is already installed in `base`).
#
# Three constraints, all of them load-bearing:
#
#   1. `libhailort.so.<version>` is NOT baked in. `_pyhailort` records it as a
#      versioned SONAME dependency (`libhailort.so.4.21.0` for the 4.21.0
#      wheel) and it has to match the PCIe driver the host kernel loaded, so it
#      is bind-mounted from the host at run time. Baking a copy would make the
#      image silently wrong on any board running a different HailoRT. Mounting
#      the versioned file alone is enough — no unversioned `.so` link and no
#      LD_LIBRARY_PATH entry are needed, since /usr/lib is already on glibc's
#      default search path.
#   2. The wheel is operator-supplied under `deploy/docker/wheels/` (Hailo
#      Developer Zone, login-gated; not on PyPI). See that directory's README
#      for the version-matching check.
#   3. gcc/python3-dev are installed and removed again in one layer: hailort
#      pulls in netifaces, which resolves to a source distribution here
#      (netifaces-0.11.0.tar.gz) and is compiled during the install.
#
# Build (from repo root, on the board or any arm64 host):
#   docker build -f deploy/docker/Dockerfile.rpi --target final-hailo \
#     --build-arg HAILORT_WHEEL=hailort-4.21.0-cp311-cp311-linux_aarch64.whl \
#     -t openvoicestream:rpi-hailo .
#
# Run (/dev/hailo0 is exclusive to one process — stop other Hailo containers):
#   docker run --device /dev/hailo0 \
#     -v /usr/lib/libhailort.so.4.21.0:/usr/lib/libhailort.so.4.21.0:ro \
#     -v ~/models:/opt/models -p 8621:8000 \
#     -e OVS_PROFILE=rpi5-hailo-whisper -e HF_ENDPOINT=https://hf-mirror.com \
#     openvoicestream:rpi-hailo
FROM base AS final-hailo

ARG HAILORT_WHEEL=hailort-4.21.0-cp311-cp311-linux_aarch64.whl
COPY deploy/docker/wheels/ /tmp/wheels/
RUN test -f /tmp/wheels/${HAILORT_WHEEL} || { \
        echo "missing deploy/docker/wheels/${HAILORT_WHEEL} — see that directory's README"; \
        exit 1; } \
    && apt-get update && apt-get install -y --no-install-recommends \
        gcc python3-dev libc6-dev \
    && pip3 install --no-cache-dir --break-system-packages \
        --index-url ${PIP_INDEX_URL} /tmp/wheels/${HAILORT_WHEEL} \
    && apt-get purge -y --auto-remove gcc python3-dev libc6-dev \
    && rm -rf /tmp/wheels /root/.cache/pip /var/lib/apt/lists/*

# The Whisper path is ASR-only and downloads its own artifacts (the .hef, the
# ONNX decoder pair, vocab + mel filters) into $MODEL_DIR/whisper. The sherpa
# offline-ASR fetch that `base` enables would pull SenseVoice for a backend
# this image does not run, so it is turned off here.
ENV OVS_PROFILE_DEFAULT=rpi5-hailo-whisper \
    ENSURE_OFFLINE_ASR=0

LABEL org.opencontainers.image.title="OpenVoiceStream (Raspberry Pi 5 + Hailo-8)" \
      org.opencontainers.image.description="Whisper ASR with the encoder on Hailo-8, decoder on CPU"

# ── Multi-target stages (no baked artifacts; thick == slim == base) ─────────
FROM base AS final-thick
FROM base AS final-slim
