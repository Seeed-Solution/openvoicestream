# syntax=docker/dockerfile:1.6
#
# OpenVoiceStream Agent — Rockchip (RK3576 / RK3588) edition.
#
# WHY THIS IMAGE EXISTS
#   Agent images existed only for Jetson (as overlays on a CUDA base). The agent
#   is the CLIENT of the voice service: it owns the microphone and speaker,
#   advertises its tool schemas over /v2v/stream, and executes the tool calls the
#   server-side LLM sends back. On Rockchip there was no such image at all.
#
#   It does NO inference, so it needs neither RKNN nor the RK userspace runtime —
#   which is why this is a small plain-Debian image rather than a variant of
#   Dockerfile.rk.
#
# The only inference asset in this image is a small, fixed-checksum wake-word
# model. ASR/TTS/LLM inference remains in the speech or model services.
#
# Build (context = repo root):
#   docker build -f deploy/docker/Dockerfile.rk.agent -t ovs-agent:rk-$(date +%Y%m%d) .
#
# Run: needs /dev/snd for the mic and speaker. See deploy/docker-compose.radxa.yml.

FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# libportaudio2 : sounddevice's backend — without it `import sounddevice` fails
#                 at load time with an OSError that does not mention PortAudio
# libsndfile1   : soundfile
# alsa-utils    : aplay/arecord, for diagnosing "which card is the mic" on a
#                 device where that is rarely obvious
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        libportaudio2 libsndfile1 alsa-utils \
        curl ca-certificates bzip2 \
    && rm -rf /var/lib/apt/lists/*

ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN pip install --no-cache-dir --index-url ${PIP_INDEX} --upgrade pip

# ── voxedge ───────────────────────────────────────────────────────────────
# From PyPI, pinned, same as the voice image (Dockerfile.rk) — keep the two pins
# in step: the agent and the server exchange tool frames, and a version skew
# between them is the kind of thing that shows up as a protocol error much later.
# Keep the configured domestic mirror primary; upstream PyPI is only a
# fallback for a release that has not propagated to the mirror yet.
ARG VOXEDGE_VERSION=0.0.15a1
RUN pip install --no-cache-dir \
        --index-url ${PIP_INDEX} \
        --extra-index-url https://pypi.org/simple \
        "voxedge==${VOXEDGE_VERSION}"

# ── client-side VAD + agent ───────────────────────────────────────────────
# The wheel is torch-free at runtime: ovs_agent.vad drives the bundled ONNX
# model directly through onnxruntime. Keep silero-vad --no-deps so its optional
# torch dependency cannot pull a multi-hundred-MB framework into the edge image.
ARG SILERO_VAD_VERSION=6.2.1
RUN pip install --no-cache-dir --index-url ${PIP_INDEX} \
        "onnxruntime>=1.17" "sherpa-onnx==1.13.6" "sentencepiece==0.2.1" "pypinyin==0.55.0" \
    && pip install --no-cache-dir --no-deps --index-url ${PIP_INDEX} \
        "silero-vad==${SILERO_VAD_VERSION}"

# ── runtime-compiled wake word ───────────────────────────────────────────
# The KWS network is independent from the user phrase: Chinese and English
# phrases are compiled on-device in milliseconds and reuse this one session.
# Pin both URL and digest so a changed upstream release cannot enter an image.
ARG KWS_MODEL_NAME=sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
ARG KWS_MODEL_URL=https://ghproxy.net/https://github.com/k2-fsa/sherpa-onnx/releases/download/kws-models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20.tar.bz2
ARG KWS_MODEL_SHA256=68447f4fbc67e70eee3a93961f36e81e98f47aef73ce7e7ca00885c6cd3616a6
RUN mkdir -p /opt/ovs/models \
    && curl -fL --retry 5 --retry-all-errors "${KWS_MODEL_URL}" -o /tmp/kws.tar.bz2 \
    && echo "${KWS_MODEL_SHA256}  /tmp/kws.tar.bz2" | sha256sum -c - \
    && tar -xjf /tmp/kws.tar.bz2 -C /opt/ovs/models \
    && test -f "/opt/ovs/models/${KWS_MODEL_NAME}/tokens.txt" \
    && test -f "/opt/ovs/models/${KWS_MODEL_NAME}/en.phone" \
    && rm -f /tmp/kws.tar.bz2

# ── agent ─────────────────────────────────────────────────────────────────
COPY agent/pyproject.toml /opt/slv/agent/pyproject.toml
COPY agent/README.md      /opt/slv/agent/README.md
COPY agent/ovs_agent      /opt/slv/agent/ovs_agent

# --no-deps for voxedge so the already-installed wheel is not replaced by a
# registry lookup for a version that is not published anywhere.
RUN cd /opt/slv/agent \
    && pip install --no-cache-dir --index-url ${PIP_INDEX} \
        "websockets>=12" "sounddevice>=0.4" "numpy>=1.24" "openai>=1.40" \
        "pyyaml>=6.0" "aiohttp>=3.9" "httpx>=0.27" \
        "fastapi>=0.110" "uvicorn[standard]>=0.27" \
    && pip install --no-cache-dir --no-deps -e /opt/slv/agent \
    && find /opt/slv/agent -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null; :

# Fail the BUILD rather than the first boot if the app or its tools cannot be
# imported — a missing tool registration shows up at runtime only as "the
# assistant never controls anything", which is a slow thing to debug.
RUN python3 -c "\
from ovs_agent.apps.home_assistant import HomeAssistantApp; \
from ovs_agent.tools import default_registry as r; \
names = r.list_names(); \
want = {'list_devices','turn_on','turn_off','set_brightness','set_cover_position','get_state','call_service'}; \
missing = want - set(names); \
assert not missing, f'HA tools not registered: {sorted(missing)}'; \
print('home_assistant ok; tools:', sorted(names))"

# Fail the build if the production image would silently fall back to the
# energy VAD. The runtime path deliberately imports no torch, and the model is
# shipped by silero-vad itself rather than downloaded on first boot.
RUN python3 -c "\
import importlib.util, pathlib; \
spec = importlib.util.find_spec('silero_vad'); \
assert spec is not None and spec.origin is not None, 'silero_vad package missing'; \
model = pathlib.Path(spec.origin).parent / 'data' / 'silero_vad.onnx'; \
assert model.is_file(), f'Silero ONNX asset missing: {model}'; \
from ovs_agent.vad import create_vad; \
vad = create_vad('auto'); \
assert vad.name == 'silero', f'client VAD unexpectedly fell back: {vad.name}'; \
print(f'client VAD ok: {vad.name}; model: {model}')"

# Exercise the lazy dependencies and native API at build time. Import checks
# alone miss text2token's pypinyin/sentencepiece imports and sherpa's non-empty
# initial-keyword requirement.
RUN python3 -c "\
from pathlib import Path; \
from ovs_agent.kws import PhraseCompiler, SherpaKwsBackend; \
p = Path('/opt/ovs/models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20'); \
c = PhraseCompiler(tokens=str(p/'tokens.txt'), lexicon=str(p/'en.phone')).compile(['你好小智', 'Hey Seeed']); \
b = SherpaKwsBackend({'tokens': str(p/'tokens.txt'), 'encoder': str(p/'encoder-epoch-13-avg-2-chunk-8-left-64.int8.onnx'), 'decoder': str(p/'decoder-epoch-13-avg-2-chunk-8-left-64.onnx'), 'joiner': str(p/'joiner-epoch-13-avg-2-chunk-8-left-64.int8.onnx'), 'num_threads': 1}); \
s = b.create_stream(c); \
assert s is not None; \
print('runtime KWS ok:', c.phrases)"

ENV PYTHONUNBUFFERED=1 \
    OVS_SLV_URL=ws://127.0.0.1:8621/v2v/stream \
    OVS_AGENT_SERVER_LOOP=0 \
    WAKEWORD_MODEL_DIR=/opt/ovs/models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20

WORKDIR /opt/slv/agent

# Default: the Home Assistant app. `run <app_name>` is a SUBCOMMAND (not --app),
# and omitting --config makes the CLI default to
# agent/apps/<app>/config.yaml, which is the file baked in above.
CMD ["python3", "-m", "ovs_agent.cli", "run", "home_assistant"]

LABEL org.opencontainers.image.title="OpenVoiceStream Agent (Rockchip)" \
      org.opencontainers.image.source="https://github.com/Seeed-Solution/openvoicestream" \
      org.opencontainers.image.description="Voice agent client: mic/speaker, runtime wake word, and tool execution"
