# Gray-only additive TensorRT-Edge-LLM v0.10 image.  It deliberately inherits
# the qualified v0.9.1 runtime while replacing all v0.10-owned binaries and
# paths.  Publication uses a new immutable image identity; it never rewrites
# the v0.9.1 tag or release lock.
ARG BASE=sensecraft-missionpack.seeed.cn/solution/seeed-local-voice:jetson-jp62-trt103-edgellm-v091-vox080a0
ARG SOURCE_REVISION=unknown
ARG V010_ALLOW_UNPUBLISHED_CANDIDATE=0
FROM ${BASE}
ARG SOURCE_REVISION
ARG V010_ALLOW_UNPUBLISHED_CANDIDATE

COPY configs/profiles/ /opt/speech/configs/profiles/
COPY server/ /opt/speech/server/
COPY scripts/check_edgellm_v010_release_lock.py /opt/speech/scripts/check_edgellm_v010_release_lock.py
COPY scripts/start_edgellm_v010_candidate_runtime.py /opt/speech/scripts/start_edgellm_v010_candidate_runtime.py
COPY deploy/artifacts/v010-candidate-release-lock.json /opt/speech/release-source/deploy/artifacts/v010-candidate-release-lock.json
COPY bench/perf/baselines/edgellm-v091-orin-nx-qualification.json /opt/speech/release-source/bench/perf/baselines/edgellm-v091-orin-nx-qualification.json
COPY bench/perf/baselines/edgellm-v091-orin-nano-qualification.json /opt/speech/release-source/bench/perf/baselines/edgellm-v091-orin-nano-qualification.json
COPY third_party/jetson-voice-engine/engine-overlay-v010/manifests/ /opt/speech/release-source/third_party/jetson-voice-engine/engine-overlay-v010/manifests/

# The committed candidate lock is intentionally non-deployable. A local gray
# build must opt in twice: once here and once at runtime. This Dockerfile can
# never build a production image; the production Dockerfile uses the separate
# build-ready gate and has no candidate override.
RUN set -eux; \
    test "${V010_ALLOW_UNPUBLISHED_CANDIDATE}" = "1"; \
    python3 /opt/speech/scripts/check_edgellm_v010_release_lock.py \
      --lock /opt/speech/release-source/deploy/artifacts/v010-candidate-release-lock.json \
      --repo-root /opt/speech/release-source --skip-gitlink-check --require-candidate

# Generated binaries remain ignored by Git. The staging directory must carry
# its own candidate checksum file, so even an opted-in gray build cannot accept
# a partially copied worker/plugin set.
COPY deploy/artifacts/v010-candidate-release-gate/ /opt/edgellm-v010/
COPY --chmod=0755 scripts/run_moss_tts_v010.sh /opt/edgellm-v010/bin/moss_tts_nano_worker_v010
RUN set -eux; \
    cd /opt/edgellm-v010; \
    ln -s libonnxruntime.so.1.20.0 moss-runtime/libonnxruntime.so.1; \
    test -s CANDIDATE-SHA256SUMS; \
    sha256sum -c CANDIDATE-SHA256SUMS; \
    test -x bin/qwen3_asr_worker; \
    test -x bin/qwen3_tts_streaming_worker; \
    test -x bin/moss_tts_nano_worker; \
    test -x bin/moss_tts_nano_worker_v010; \
    test -x bin/spark_tts_worker; \
    test -s libNvInfer_edgellm_plugin.so

ENV EDGELLM_V010_ROOT=/opt/edgellm-v010 \
    EDGELLM_PLUGIN_PATH=/opt/edgellm-v010/libNvInfer_edgellm_plugin.so \
    EDGE_LLM_ASR_PLUGIN_PATH=/opt/edgellm-v010/libNvInfer_edgellm_plugin.so \
    HF_ENDPOINT=https://hf-mirror.com \
    HF_MODEL_CACHE_ROOT=/opt/models-v010-candidate \
    OVS_AUTO_DOWNLOAD_ARTIFACTS=0 \
    LANGUAGE_MODE=multilanguage \
    PYTHONPATH=/opt/edgellm-v010/python:/opt/speech:/usr/lib/python3.10/dist-packages \
    OVS_PROFILE=jetson-edgellm-v010-candidate-matcha \
    EDGELLM_V010_ALLOW_UNPUBLISHED_CANDIDATE=0

LABEL org.opencontainers.image.title="seeed-local-voice TensorRT-Edge-LLM v0.10 candidate runtime" \
      org.opencontainers.image.version="v0.10-candidate" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      com.seeed.release-state="candidate_unpublished" \
      com.seeed.rollback-lock="deploy/artifacts/v091-release-lock.json" \
      com.seeed.edgellm.submodule="cac7b496f0eff904bc8f24e3a0d5a542080b65e3"

CMD ["python3", "/opt/speech/scripts/start_edgellm_v010_candidate_runtime.py"]
