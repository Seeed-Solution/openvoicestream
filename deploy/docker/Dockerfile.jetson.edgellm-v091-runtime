# Generic Jetson runtime for TensorRT-Edge-LLM v0.9.1.  Runtime binaries,
# workers and the plugin are immutable image content; device-qualified model
# engines are selected by OVS_PROFILE and downloaded into a persistent volume.
ARG BASE=sensecraft-missionpack.seeed.cn/solution/seeed-local-voice:jetson-v1.16-symlink
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 上游 PyPI 作为补充源。国内镜像同步有延迟：2026-08-06 实测 voxedge 0.0.7a0
# 发布后清华站仍只有 0.0.6a1，只用镜像会让「刚发布的版本装不上」，而下面的
# pip install 又是硬失败（设计如此，见其注释），构建会直接卡住。
#
# 两个源并列在这里是安全的：清华站是 PyPI 的**镜像**而非独立仓库，同名包同版本
# 指向同一份产物，不存在依赖混淆（dependency confusion）的空间。若将来引入私有
# 索引，则必须改用 --index-strategy 明确优先级。
ARG PIP_EXTRA_INDEX_URL=https://pypi.org/simple
ARG SOURCE_REVISION=unknown
ARG VOXEDGE_VERSION=0.0.15a1
FROM ${BASE}
ARG PIP_INDEX_URL
ARG PIP_EXTRA_INDEX_URL
ARG SOURCE_REVISION
ARG VOXEDGE_VERSION

# 整个目录一起覆盖，而不是只挑 v091 那 9 个。此前只挑 v091 的做法留下一个
# 漂移缺口：其余 ~24 个 profile 沿用基础镜像里两个月前的版本，仓库里对它们的
# 修改永远进不了这个镜像。2026-08-07 的 EDGE_LLM_ASR_PLUGIN_PATH 修复就是这样
# 在镜像里查无此改动的（改了仓库、建了镜像、profile_owned_env 仍是 None）。
#
# 安全性：改这行时逐文件比对过仓库版与基础镜像版，差异恰好等于本次修改的
# 7 个 profile，其余字节相同 —— 覆盖不引入意料外的行为变化。
COPY configs/profiles/ /opt/speech/configs/profiles/

# The old deployment base still starts `app.main`; replace the complete server
# package so v0.9.1 profiles, admission control, and current backend contracts
# move together rather than mixing new files with an old app/core tree.
COPY server/ /opt/speech/server/
COPY scripts/check_moss_worker_runtime.py /opt/speech/scripts/check_moss_worker_runtime.py
COPY scripts/start_edgellm_v091_runtime.py /opt/speech/scripts/start_edgellm_v091_runtime.py
COPY deploy/artifacts/v091-release-lock.json /opt/speech/deploy/v091-release-lock.json
# Install the exact published VoxEdge release. Do not COPY an ignored/local
# wheel into a production build; package installation must fail rather than
# fall back to a stale wheel.
# The release builder stages the complete locked v0.9.1 runtime binary set.
# These files stay out of Git, but a missing worker/plugin/runtime makes the
# image build fail rather than silently inheriting an older binary from BASE.
COPY deploy/artifacts/v091-release-gate/bin/ /opt/edgellm-v091/bin/
COPY deploy/artifacts/v091-release-gate/libNvInfer_edgellm_plugin.so /opt/edgellm-v091/libNvInfer_edgellm_plugin.so
COPY deploy/artifacts/v091-release-gate/python/ /opt/edgellm-v091/python/

RUN set -eux; \
    PIP_INDEX_URL="${PIP_INDEX_URL}" PIP_EXTRA_INDEX_URL="${PIP_EXTRA_INDEX_URL}" \
      pip install --no-cache-dir --no-deps --force-reinstall \
      "voxedge==${VOXEDGE_VERSION}"; \
    PIP_INDEX_URL="${PIP_INDEX_URL}" PIP_EXTRA_INDEX_URL="${PIP_EXTRA_INDEX_URL}" \
      pip install --no-cache-dir -r /opt/speech/server/requirements.txt; \
    python3 -c "from voxedge.backends.base import TTSCapability; from voxedge.backends.jetson.trt_edge_llm_tts import TRTEdgeLLMTTSBackend, TRTEdgeLLMTTSConfig; b=TRTEdgeLLMTTSBackend(TRTEdgeLLMTTSConfig(model_id='qwen3-tts-customvoice')); assert not b.supports_voice_cloning and TTSCapability.VOICE_CLONE not in b.capabilities"; \
    printf '%s  %s\n' \
      0d4a1aeddad638ecd295605ad0fad6eb0ec2fd7f907f59feb546f3ae046fe15a /opt/edgellm-v091/bin/qwen3_asr_worker \
      e07e7ab51932b217a20046f07ffd628aa0809814367b2cb26f27b1a4343a2a90 /opt/edgellm-v091/bin/qwen3_tts_streaming_worker \
      0e0f886cd188fbbf45a3ecc058e6fbdf58b7a7aebacc600212607afbe4b32008 /opt/edgellm-v091/bin/spark_tts_worker \
      9d114d8390e684c8876e2ef9e20e28ee6d4ec6ce18b81df5da3ba64c8f057deb /opt/edgellm-v091/bin/moss_tts_nano_worker \
      82bb174986b6968db67a523aea0bda43b83ba06684be7f7bb9e4e38eb3105adf /opt/edgellm-v091/libNvInfer_edgellm_plugin.so \
      6854639b1c699902156ecb718cb3659fe1cdd8e56786a346d0f1dc3248eb5d8d /opt/edgellm-v091/python/_edgellm_runtime.cpython-310-aarch64-linux-gnu.so \
      | sha256sum -c -; \
    chmod 0755 /opt/edgellm-v091/bin/*

# The base image ships ORT 1.23.2 from the Python wheel but omits its
# libonnxruntime.so.1 SONAME link. Native MOSS workers link that SONAME.
# Build time has no compose host-library mounts, so validate the immutable
# worker contract and imported ORT symbol version here. The CMD wrapper repeats
# these checks and adds full ldd -r only after host + artifact mounts exist.
RUN set -eux; \
    ort_dir=/usr/local/lib/python3.10/dist-packages/onnxruntime/capi; \
    test -s "${ort_dir}/libonnxruntime.so.1.23.2"; \
    ln -sf libonnxruntime.so.1.23.2 "${ort_dir}/libonnxruntime.so.1"; \
    LD_LIBRARY_PATH="${ort_dir}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
      python3 /opt/speech/scripts/check_moss_worker_runtime.py \
      --worker /opt/edgellm-v091/bin/moss_tts_nano_worker \
      --release-lock /opt/speech/deploy/v091-release-lock.json \
      --skip-ldd

RUN python3 -m py_compile \
      /opt/speech/server/core/capability_resolver.py \
      /opt/speech/server/core/hf_artifacts.py \
      /opt/speech/server/core/model_downloader.py \
      /opt/speech/server/core/qwen3_artifact_downloader.py \
      /opt/speech/server/core/worker_io.py \
      /opt/speech/server/core/sparktts_voices.py \
      /opt/speech/server/main.py

# Runtime-created speaker registrations and SparkTTS VoiceProfiles are user
# data.  Keep their root explicit in the image even when Compose later mounts
# the external ``seeed-local-voice-data`` volume over it.  The published base
# image runs the service as root, so 0775 leaves the directory writable while
# still avoiding a world-writable data path.
RUN mkdir -p /opt/seeed-local-voice/data/sparktts_voices \
    && chmod 0775 /opt/seeed-local-voice/data \
                 /opt/seeed-local-voice/data/sparktts_voices

ENV EDGELLM_V091_ROOT=/opt/edgellm-v091 \
    EDGELLM_PLUGIN_PATH=/opt/edgellm-v091/libNvInfer_edgellm_plugin.so \
    EDGE_LLM_ASR_PLUGIN_PATH=/opt/edgellm-v091/libNvInfer_edgellm_plugin.so \
    HF_ENDPOINT=https://hf-mirror.com \
    HF_MODEL_CACHE_ROOT=/opt/models \
    OVS_AUTO_DOWNLOAD_ARTIFACTS=1 \
    PYTHONPATH=/opt/edgellm-v091/python:/opt/speech:/usr/lib/python3.10/dist-packages \
    OVS_TTS_SPEAKERS_FILE=/opt/seeed-local-voice/data/speakers.json \
    SPARKTTS_VOICES_DIR=/opt/seeed-local-voice/data/sparktts_voices \
    OVS_PROFILE=jetson-edgellm-v091-matcha

LABEL org.opencontainers.image.title="seeed-local-voice TensorRT-Edge-LLM v0.9.1 runtime" \
      org.opencontainers.image.version="v0.9.1" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      com.seeed.voxedge.version="${VOXEDGE_VERSION}" \
      com.seeed.model-artifact-schema="2" \
      com.seeed.model-artifact-layout="one-huggingface-repository-per-model"

CMD ["python3", "/opt/speech/scripts/start_edgellm_v091_runtime.py"]
