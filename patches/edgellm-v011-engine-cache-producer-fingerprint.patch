+def _profile_identity(options: BuildOptions) -> dict:
+    return {
+        **{field.name: getattr(options, field.name)
+           for field in fields(options) if field.name not in {
+               "draft_model_dir", "plugin_path"
+           }},
+        "builder_spec_type": options.builder_spec_type,
+    }
+
+
+def _sha256_file(path: str) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as file:
+        for chunk in iter(lambda: file.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _producer_source_digest() -> str:
+    root = Path(__file__).resolve().parents[3]
+    digest = hashlib.sha256()
+    for relative in _PRODUCER_SOURCE_FILES:
+        path = root / relative
+        if not path.is_file():
+            raise FileNotFoundError(f"producer source file is missing: {path}")
+        digest.update(relative.encode("utf-8"))
+        digest.update(_sha256_file(str(path)).encode("ascii"))
+    return digest.hexdigest()
+
+
+def _resolve_plugin_path(explicit: str) -> str:
+    selected = explicit or os.environ.get("EDGELLM_PLUGIN_PATH", "")
+    if not selected:
+        from .engine import _ensure_plugin_path
+        _ensure_plugin_path()
+        selected = os.environ.get("EDGELLM_PLUGIN_PATH", "")
+    if selected:
+        path = Path(selected).expanduser().resolve()
+        if not path.is_file():
+            raise FileNotFoundError(f"plugin library not found: {path}")
+        return str(path)
+    project_root = Path(__file__).resolve().parents[3]
+    for path in (
+            project_root / "build" / "core" / _PLUGIN_LIB_NAME,
+            project_root / "build" / "lib" / _PLUGIN_LIB_NAME,
+            Path.cwd() / "build" / "lib" / _PLUGIN_LIB_NAME):
+        if path.is_file():
+            return str(path.resolve())
+    raise FileNotFoundError(
+        "unable to resolve an effective Edge-LLM plugin library; set "
+        "EDGELLM_PLUGIN_PATH or provide build/core or build/lib")
+
+
+def _producer_fingerprint(options: BuildOptions) -> dict:
+    plugin_path = _resolve_plugin_path(options.plugin_path)
+    return {
+        "plugin_sha256": _sha256_file(plugin_path),
+        "builder_source_sha256": _producer_source_digest(),
+    }
+
+
+def _write_producer_receipt(bundle_dir: str, options: BuildOptions,
+                            producer: dict) -> None:
+    receipt = {
+        "cache_layout_version": _CACHE_LAYOUT_VERSION,
+        "profile": _profile_identity(options),
+        "producer_fingerprint": producer,
+    }
+    path = os.path.join(bundle_dir, _PRODUCER_RECEIPT)
+    temporary = path + ".tmp"
+    with open(temporary, "w", encoding="utf-8") as file:
+        json.dump(receipt, file, sort_keys=True, indent=2)
+        file.write("\n")
+    os.replace(temporary, path)
+
+
+def _producer_receipt_matches(bundle_dir: str, options: BuildOptions,
+                              producer: dict) -> bool:
+    try:
+        with open(os.path.join(bundle_dir, _PRODUCER_RECEIPT),
+                  encoding="utf-8") as file:
+            receipt = json.load(file)
+        if not isinstance(receipt, dict):
+            return False
+        return (receipt.get("cache_layout_version") == _CACHE_LAYOUT_VERSION
+                and receipt.get("profile") == _profile_identity(options)
+                and receipt.get("producer_fingerprint") == producer)
+    except (OSError, ValueError, TypeError):
+        return False
+
+
